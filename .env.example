# PostgreSQL development database (replace placeholder values locally).
POSTGRES_DB=mediplan_ai
POSTGRES_USER=mediplan_dev
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional full connection-string override. When set, it takes precedence over
# the POSTGRES_* variables above (used by the backend and Alembic).
# DATABASE_URL=postgresql+psycopg://mediplan_dev:local-password@localhost:5432/mediplan_ai

# Local service ports and frontend-to-backend base URL.
BACKEND_PORT=8000
VITE_API_BASE_URL=http://localhost:8000
